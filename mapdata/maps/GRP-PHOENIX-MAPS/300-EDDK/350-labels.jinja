{%- from "_macros.jinja" import render_multilinetext -%}

// ========================< Taxiway Labels >========================

// - - - - - - - - - - - - - Label Buffer - - - - - - - - - - - - - -

MAP:Buffer EDDK
AIRPORT:EDDK
FOLDER:Labels
HIDDEN
LAYER:3
ZOOM:400
COLOR:LAYOUT_TAXIWAY
{{ data.eddk_info['LabelBuffer']['taxiway'] | render_grp }}

COLOR:LAYOUT_APRON
{{ data.eddk_info['LabelBuffer']['apron'] | render_grp }}

// - - - - - - - - - - - - - - Labels - - - - - - - - - - - - - - - -

MAP:Taxiways
AIRPORT:EDDK
FOLDER:Labels
OTHER_MAP_ACT:=:Labels\Buffer EDDK
LAYER:6
ZOOM:400
FONTSIZE:=:10
COLOR:LAYOUT_LABEL_YELLOW
{{ data.eddk_info['TaxiwayLabel'] | feat_where('zoomlevel', 400)
    | feat_exclude('designator', 'K1') | render_text(prop='text')
-}}
{{ data.eddk_info['TaxiwayLabel']['K1'] | render_text(prop='text', align='RC') }}

// =========================< Stand Labels >=========================

MAP:Stands
AIRPORT:EDDK
FOLDER:Labels
ACTIVE:1
OTHER_MAP_ACT:=:Labels\Areas 
LAYER:6
ZOOM:500
FONTSIZE:=:9
COLOR:LAYOUT_LABEL_YELLOW
{{ data.eddk_info['StandLabel'] | feat_where('zoomlevel', 500) | render_text(prop='designator') }}

{{ data.eddk_info['AreaLabel']['apron_v_1x1'] | render_text(prop='text') -}}
{{ data.eddk_info['AreaLabel']['apron_v_2x1'] | render_text(prop='text') -}}
COLOR:LAYOUT_HOLDINGPOINT
{{ data.eddk_info['AreaLabel']['apron_v_3x0'] | render_text(prop='text') -}}
{{ data.eddk_info['AreaLabel']['apron_v_4x0'] | render_text(prop='text') -}}
{{ data.eddk_info['AreaLabel']['apron_v_5x0'] | render_text(prop='text') }}

ZOOM:1500
COLOR:LAYOUT_LABEL_YELLOW
{{ data.eddk_info['StandLabel'] | feat_where('zoomlevel', 1500) | render_text(prop='designator') }}

ZOOM:2500
{{ data.eddk_info['StandLabel'] | feat_where('zoomlevel', 2500)
    | feat_exclude('colour', 'ORANGE') | render_text(prop='designator')
}}

COLOR:LAYOUT_HOLDINGPOINT
{{ data.eddk_info['StandLabel'] | feat_where('colour', 'ORANGE') | render_text(prop='designator') }}

// =========================< Area Labels >==========================

// There is a space symbol at the end of the map name to avoid accidental activation by eddk and EDDS stand maps
MAP:Areas 
AIRPORT:EDDK
FOLDER:Labels
LAYER:6
ACTIVE:1
ZOOM:400
FONTSIZE:=:10
COLOR:LAYOUT_LABEL_STAND
{{ data.eddk_info['AreaLabel']['apron_u'] | render_text('Maintenance', offset=(0,-10)) -}}
{{ data.eddk_info['AreaLabel']['apron_v_3x0'] | render_text('GAT', offset=(0,-15)) -}}
{{ data.eddk_info['AreaLabel']['bmi'] | render_text(prop='text') -}}
{{ data.eddk_info['AreaLabel']['apron_2'] | render_text('Bundeswehr', offset=(0,-10)) -}}
{{ data.eddk_info['AreaLabel']['apron_z'] | render_text('Bundeswehr', offset=(0,-10)) }}

// =========================< Apron Labels >=========================

MAP:Aprons
AIRPORT:EDDK
FOLDER:Labels
LAYER:6
ZOOM:400
FONTSIZE:=:10
COLOR:LAYOUT_LABEL_STAND
{{ data.eddk_info['AreaLabel']
    | feat_exclude('designator', 'apron_v_1x1', 'apron_v_2x1', 'apron_v_3x0', 'apron_v_4x0', 'apron_v_5x0', 'bmi')
    | render_text(prop='text')
-}}
{{ data.eddk_info['AreaLabel']['apron_v_3x0'] | render_text('           /Apron V', offset=(0,-15)) }}


// =======================< Building Labels >========================

MAP:Buildings
AIRPORT:EDDK
FOLDER:Labels
ZOOM:400
FONTSIZE:=:9
COLOR:LAYOUT_LABEL_STAND
{% for feat in data.eddk_info['BuildingLabel'].values() %}
{{ render_multilinetext(feat, 12) }}
{% endfor %}