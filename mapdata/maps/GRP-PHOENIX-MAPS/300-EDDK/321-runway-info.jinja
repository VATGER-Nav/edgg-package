// =========================< RRS Markers >==========================

{% for runway in ['31R', '13L', '31L', '13R'] %}
MAP:RRS {{runway}}
AIRPORT:EDDK
FOLDER:Runway Info
LAYER:6
ACTIVE:RWY:ARR:EDDK{{runway}}:DEP:*
ACTIVE:RWY:ARR:*:DEP:EDDK{{runway}}
COLOR:RRS_MARKER
{{ data.eddk_info['RRSMarker'] | feat_where('runway', runway) | render_symbol('RRS') -}}
FONTSIZE:=:12
ZOOM:400
TEXTALIGN:CB
{{ data.eddk_info['RRSMarker'] | feat_where('runway', runway) | render_text(prop='text', offset=(0,-10)) }}
{% endfor %}

{% for runway in ['24', '06'] %}
MAP:RRS {{runway}}
AIRPORT:EDDK
FOLDER:Runway Info
LAYER:6
ACTIVE:RWY:ARR:EDDK{{runway}}:DEP:*
ACTIVE:RWY:ARR:*:DEP:EDDK{{runway}}
COLOR:RRS_MARKER
{{ data.eddk_info['RRSMarker'] | feat_where('runway', runway) | render_symbol('RRS-E') -}}
FONTSIZE:=:12
ZOOM:400
TEXTALIGN:LC
{{ data.eddk_info['RRSMarker'] | feat_where('runway', runway) | render_text(prop='text', offset=(13,0)) }}
{% endfor %}

// =======================< TORA Distances >=========================

{% for runway in ['31R', '13L', '31L', '13R', '24', '06'] %}
MAP:TORA {{runway}}
AIRPORT:EDDK
FOLDER:Runway Info
LAYER:6
COLOR:TORA_LABEL
ZOOM:400
{% for feat in data.eddk_info['TORALabel'] | feat_where('runway', runway) %}
{{- feat | render_text(prop='tora', align=feat.properties.textalign) -}}
{% endfor %}
{% endfor %}

