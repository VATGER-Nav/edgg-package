// ------------------------------------------------------------------
//                                 EDDK
// ------------------------------------------------------------------

// -------------------------- Ground Layout -------------------------
{%- set tolerance = 0.000005 %}

MAP:Apron Area
AIRPORT:EDDK
FOLDER:Airport Layout
ACTIVE:1
COLOR:LAYOUT_APRON
{% for _, feat in data.eddk_kml['layout']['aprons'].items() %}
{{- feat | render_area('OTHER:REGION') }}
{% endfor %}


MAP:Roads
AIRPORT:EDDK
FOLDER:Airport Layout
ACTIVE:1
COLOR:LAYOUT_TAXIWAY
{% for _, feat in data.eddk_kml['layout']['roads'].items() %}
{{- feat | geom_simplify(tolerance) | render_line }}
{% endfor %}


MAP:Taxiway Movement Area
AIRPORT:EDDK
FOLDER:Airport Layout
ACTIVE:1
COLOR:LAYOUT_TAXIWAY
{% for _, feat in data.eddk_kml['layout']['taxiways'].items() %}
{{- feat | render_area('OTHER:REGION') }}
{% endfor %}


MAP:Runways
AIRPORT:EDDK
FOLDER:Airport Layout
ACTIVE:1
COLOR:LAYOUT_APRON
{% for desig in
[
    'rwyBlastpad31L',
    'rwyBlastpad13R',
    'rwyBlastpad31R',
    'rwyBlastpad13L',
    'rwyBlastpad24',
    'rwyBlastpad06'
] %}
{{- data.eddk_kml['layout']['runways'][desig] | render_area('OTHER:REGION', desig) }}
{% endfor %}
COLOR:LAYOUT_RUNWAY
{{ data.eddk_kml['layout']['runways']['13L-31R'] | render_area('OTHER:REGION', 'Runway 13L/31R') }}
{{ data.eddk_kml['layout']['runways']['13R-31L'] | render_area('OTHER:REGION', 'Runway 13R/31L') }}
{{ data.eddk_kml['layout']['runways']['06-24'] | render_area('OTHER:REGION', 'Runway 06/24') }}
