{% for runway in ['31R', '13L'] %}
MAP:{{runway}}
AIRPORT:EDDK
FOLDER:LVP|Heavy
COLOR:LVP_ORTHOGONAL
{{ data.eddk_kml['layout']['lvp']['heavy'][runway + '_orthogonal_a'] | render_area('OTHER:REGION:\\') }}
{{ data.eddk_kml['layout']['lvp']['heavy'][runway + '_orthogonal_b'] | render_area('OTHER:REGION:\\') }}
COLOR:LVP_SENSITIVE
{{ data.eddk_kml['layout']['lvp']['heavy'][runway + '_sensitive'] | render_area('OTHER:REGION:\\') }}
COLOR:LVP_CRITICAL
STYLE:SOLID:2
{{ data.eddk_kml['layout']['lvp']['heavy'][runway + '_critical_loc'] | render_area('OTHER:REGION:\\') }}
{{ data.eddk_kml['layout']['lvp']['heavy'][runway + '_critical_gs'] | render_area('OTHER:REGION:\\') }}
// LOC
STYLE:SOLID:2
COLOR:LVP_MARKING
{{ loc_tick(runways.EDDK[runway], 0, -0.01) }}
{{ loc_tick(runways.EDDK[runway], 0, 0.01) }}
{% endfor %}

