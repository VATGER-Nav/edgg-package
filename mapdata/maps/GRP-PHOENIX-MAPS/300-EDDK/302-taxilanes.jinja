// - - - - - - - - - - - - - Yellow Lanes - - - - - - - - - - - - - -

COLOR:LAYOUT_TAXILINE_YELLOW
{% for feat in data.eddk_aixm['GuidanceLine']
    | feat_where('type', 'APRON', 'TWY')
    | feat_exclude('designator', *(apron_v + orangelanes + bluelanes))
%}
{{ feat | feat_simplify(tolerance) | render_line(feat.properties.designator) }}
{% endfor %}

