{%- from "_macros.jinja" import render_point %}

MAP:Break Away Areas
AIRPORT:EDDF
FOLDER:Apron Info
ACTIVE:1
LAYER:6
ZOOM:300
COLOR:LAYOUT_TAXIWAY
STYLE:SOLID:6
