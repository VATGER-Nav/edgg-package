{{- feat | render_line }}
{% endfor %}
STYLE:SOLID:2
{% for _, feat in data.eddf_info['BAA_Line'].items() if feat.properties['type'] == 'DIRECTION' %}
{{- feat | render_line }}
{% endfor %}
{% for _, feat in data.eddf_info['BAALabel'].items() %}
{{- render_point(feat, 'TEXT', feat.properties['text']) }}
{% endfor %}

