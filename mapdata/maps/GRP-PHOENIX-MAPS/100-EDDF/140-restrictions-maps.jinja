// - - - - - - - - - - - - Stand Restrictions - - - - - - - - - - - -

TEXTALIGN:CC
FONTSIZE:=:9
COLOR:RESTRICTIONS_AB
{% for feat in data.eddf_info['RestrictionStand'] | feat_where('restriction', 'A', 'B') %}
{{- render_restriction(feat) -}}
{% endfor %}
COLOR:RESTRICTIONS_C
{% for feat in data.eddf_info['RestrictionStand'] | feat_where('restriction', 'C') %}
{{- render_restriction(feat) -}}
{% endfor %}
COLOR:RESTRICTIONS_D
{% for feat in data.eddf_info['RestrictionStand'] | feat_where('restriction', 'D') %}
{{- render_restriction(feat) -}}
{% endfor %}
COLOR:RESTRICTIONS_E
{% for feat in data.eddf_info['RestrictionStand'] | feat_where('restriction', 'E') %}
{{- render_restriction(feat) -}}
{% endfor %}
COLOR:RESTRICTIONS_F
{% for feat in data.eddf_info['RestrictionStand'] | feat_where('restriction', 'B748') %}
{{- render_restriction(feat) -}}
{% endfor %}
COLOR:RESTRICTIONS_F2
{% for feat in data.eddf_info['RestrictionStand'] | feat_where('restriction', 'F') %}
{{- render_restriction(feat) -}}
{% endfor %}

