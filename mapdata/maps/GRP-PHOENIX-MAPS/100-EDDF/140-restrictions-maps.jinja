// ------------------------ Restriction Maps ------------------------
{#- TODO: Remove macros when filters for the new API are implemented #}
{%- from "_macros.jinja" import render_point %}

{%- macro render_restriction(feat) %}
{{- render_point(
        feat,
        'SYMBOL:STAND_S' if feat.properties['is_secondary'] == true else 'SYMBOL:STAND',
        feat.properties['text']+':0:15' if feat.properties['text'] != none
) }}
{%- endmacro %}

