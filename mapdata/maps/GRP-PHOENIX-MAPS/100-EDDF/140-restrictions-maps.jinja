// =======================< Restriction Maps >=======================

{%- from "_macros.jinja" import render_restriction %}

MAP:Restrictions
AIRPORT:EDDF
FOLDER:Restrictions
OTHER_MAP_ACT:=:Restrictions\BAA Restrictions
ZOOM:300
LAYER:2

