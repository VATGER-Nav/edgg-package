// ------------------------- Holding Points -------------------------
{#- TODO: Change simplify() to geom_simplify() when AIXM2 parser gets fixed #}
{%- set tolerance = 0.000005 %}
{%- set stopbars_cat1 = ['L', 'M', 'N', 'N-South', 'S', 'W1', 'W3', 'W9', 'Y5', 'Y9'] %}
{%- set index_table = data.eddf_idx['TaxiwayMarking_Index'] %}

MAP:Holding Points CAT I
AIRPORT:EDDF
FOLDER:Holding Points
ACTIVE:LVP:EDDF:0
LAYER:5
COLOR:LAYOUT_HOLDINGPOINT
{% for desig, feat in data.eddf_kml['layout']['holdingpoints']['cat1'].items() %}
{{- feat | render_area('OTHER:REGION', desig) }}
{% endfor %}
COLOR:LAYOUT_HOLDINGPOINT_GREY
{% for desig, feat in data.eddf_kml['layout']['stopbars']['poly'].items() %}
{{- feat | render_area('OTHER:REGION', desig) }}
{% endfor %}
{% for desig, feat in data.eddf_kml['layout']['holdingpoints']['cat3'].items() %}
{{- feat | render_area('OTHER:REGION', desig + ' CAT III') }}
{% endfor %}
STYLE:SOLID:2
COLOR:LAYOUT_HOLDINGPOINT
{% for desig, feat in data.eddf_kml['layout']['holdingpoints']['line'].items() %}
{{- feat | render_line(desig) }}
{% endfor %}
COLOR:LAYOUT_HOLDINGPOINT_GREY
{% for desig, feat in data.eddf_kml['layout']['stopbars']['line'].items() %}
{{- feat | render_line(desig) }}
{% endfor %}


MAP:Holding Points CAT II/III
AIRPORT:EDDF
FOLDER:Holding Points
ACTIVE:LVP:EDDF:1
LAYER:5
COLOR:LAYOUT_HOLDINGPOINT_RED
{% for desig, feat in data.eddf_kml['layout']['holdingpoints']['cat3'].items() %}
{{- feat | render_area('OTHER:REGION', desig + ' CAT III') }}
{% endfor %}
{% for desig, feat in data.eddf_kml['layout']['stopbars']['poly'].items() if not desig in stopbars_cat1 %}
{{- feat | render_area('OTHER:REGION', desig + ' CAT III') }}
{% endfor %}
COLOR:LAYOUT_HOLDINGPOINT_GREY
{% for desig in stopbars_cat1 %}
{{- data.eddf_kml['layout']['stopbars']['poly'][desig] | render_area('OTHER:REGION', desig + ' CAT I') }}
{% endfor %}
STYLE:SOLID:2
COLOR:LAYOUT_HOLDINGPOINT_RED
{% for desig, feat in data.eddf_kml['layout']['stopbars']['line'].items() if not desig in stopbars_cat1 %}
{{- feat | render_line(desig + ' CAT III') }}
{% endfor %}
COLOR:LAYOUT_HOLDINGPOINT_GREY
{% for desig in stopbars_cat1 %}
{{- data.eddf_kml['layout']['stopbars']['line'][desig] | render_line(desig + ' CAT I') }}
{% endfor %}


MAP:Stopbars
AIRPORT:EDDF
FOLDER:Holding Points
ACTIVE:1
COLOR:LAYOUT_TAXILINE_GREY
{% for _, feat in data.eddf_gpkg['HoldingPoint_PolyDot'].items() %}
{{- feat | render_area('OTHER:REGION') }}
{% endfor %}


MAP:All Stopbars
AIRPORT:EDDF
FOLDER:Holding Points
COLOR:LAYOUT_HOLDINGPOINT
LAYER:5
{% for uuid, _ in index_table.items() %}
{{- data.eddf_aixm['TaxiwayMarking'][uuid] | simplify(tolerance) | render_line(uuid) }}
{% endfor %}