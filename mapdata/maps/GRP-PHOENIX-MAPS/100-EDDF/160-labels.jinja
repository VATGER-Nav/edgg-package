{%- from "_macros.jinja" import render_multilinetext -%}

// ========================< Taxiway Labels >========================

MAP:Taxiways
AIRPORT:EDDF
FOLDER:Labels
LAYER:6
ACTIVE:1
OTHER_MAP_ACT:=:Labels\Stopbars
ZOOM:300
FONTSIZE:=:10
COLOR:LAYOUT_LABEL_TAXIWAY
{{ data.eddf_info['TaxiwayLabel'] | feat_where('zoomlevel', 300) | render_text(prop='text') }}

ZOOM:800
FONTSIZE:=:9
COLOR:LAYOUT_LABEL_STAND
{{ data.eddf_info['TaxiwayLabel']['Link3'] | render_text(prop='text', align='CC') -}}
{#- South Up -#}
FILTER_ASR:EDDF_GND
{{ data.eddf_info['TaxiwayLabel']['Link4'] | render_text(prop='text', align='LC') -}}
{{ data.eddf_info['TaxiwayLabel']['Link5'] | render_text(prop='text', align='RC') -}}
{#- North Up -#}
FILTER_ASR:EDDF_S_GND
{{ data.eddf_info['TaxiwayLabel']['Link4'] | render_text(prop='text', align='RC') -}}
{{ data.eddf_info['TaxiwayLabel']['Link5'] | render_text(prop='text', align='LC') }}

// =========================< Stand Labels >=========================

MAP:Stands
AIRPORT:EDDF
FOLDER:Labels
LAYER:6
ACTIVE:1
ZOOM:400
FONTSIZE:=:9
COLOR:LAYOUT_LABEL_STAND
{{ data.eddf_info['StandLabel'] | feat_where('zoomlevel', 400) | render_text(prop='designator') }}
{{ data.eddf_info['AreaLabel']['GAT'] | render_text(prop='text') }}

ZOOM:600
{{ data.eddf_info['StandLabel'] | feat_where('zoomlevel', 600) | render_text(prop='designator') }}

ZOOM:800
{{ data.eddf_info['StandLabel'] | feat_where('zoomlevel', 800) | render_text(prop='designator') }}

ZOOM:1200
{{ data.eddf_info['StandLabel'] | feat_where('zoomlevel', 1200) | render_text(prop='designator') }}

{#- South Up #}
FILTER_ASR:EDDF_GND
{% for desig in ['C14', 'C15', 'C16'] %}
{{- data.eddf_info['StandLabel'][desig] | render_text(' '+desig+'S', offset=(0,12)) -}}
{% endfor %}
{#- North Up -#}
FILTER_ASR:EDDF_S_GND
{% for desig in ['C14', 'C15', 'C16'] %}
{{- data.eddf_info['StandLabel'][desig] | render_text(' '+desig+'S', offset=(0,-12)) -}}
{% endfor %}

// ========================< Stopbar Labels >========================

MAP:Stopbars
AIRPORT:EDDF
FOLDER:Labels
LAYER:6
ACTIVE:1
ZOOM:400
FONTSIZE:=:9
COLOR:LAYOUT_LABEL_STAND
{#- South Up #}
FILTER_ASR:EDDF_GND
{% for feat in data.eddf_info['HoldingPointLabel'].values() %}
{{- feat | render_text(prop='designator', align=feat.properties.textalign) -}}
{% endfor %}
{#- North Up #}
FILTER_ASR:EDDF_S_GND
{% for feat in data.eddf_info['HoldingPointLabel'].values() %}
{{- feat | render_text(prop='designator', align=feat.properties.textalign_s) -}}
{% endfor %}

// =======================< Building Labels >========================

MAP:Buildings
AIRPORT:EDDF
FOLDER:Labels
ZOOM:400
FONTSIZE:=:9
COLOR:LAYOUT_LABEL_STAND
{% for feat in data.eddf_info['BuildingLabel'].values() %}
{{ render_multilinetext(feat, 12) }}
{% endfor %}