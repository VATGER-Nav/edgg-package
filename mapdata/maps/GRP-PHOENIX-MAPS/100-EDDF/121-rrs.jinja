FOLDER:Runway Info|RRS
LAYER:6
COLOR:RRS_MARKER
{#- South Up #}
FILTER_ASR:EDDF_GND
{{ render_point(data.eddf_info['RRSMarker'][runway+'_600'], 'SYMBOL:RRS') }}
{{ render_point(data.eddf_info['RRSMarker'][runway+'_1500'], 'SYMBOL:RRS') }}
{#- North Up #}
FILTER_ASR:EDDF_S_GND
{{ render_point(data.eddf_info['RRSMarker'][runway+'_600_s'], 'SYMBOL:RRS') }}
{{ render_point(data.eddf_info['RRSMarker'][runway+'_1500_s'], 'SYMBOL:RRS') }}
{% endfor %}