// =========================< RRS Markers >==========================

// - - - - - - - - - - - - - - - 2400 - - - - - - - - - - - - - - - -

{% for runway in ['25L', '07R', '25C', '07C', '25R', '07L'] %}
MAP:RRS {{runway}}
AIRPORT:EDDF
FOLDER:Runway Info|RRS
LAYER:6
ACTIVE:RWY:ARR:EDDF{{runway}}:DEP:*
ACTIVE:RWY:ARR:*:DEP:EDDF{{runway}}
COLOR:RRS_MARKER
{#- South Up #}
FILTER_ASR:EDDF_GND
{{ data.eddf_info['RRSMarker'][runway+'_2400'] | render_symbol('RRS') }}
{#- North Up -#}
FILTER_ASR:EDDF_S_GND
{{ data.eddf_info['RRSMarker'][runway+'_2400_s'] | render_symbol('RRS') }}
{% endfor %}

MAP:RRS 18
AIRPORT:EDDF
FOLDER:Runway Info|RRS
LAYER:6
ACTIVE:RWY:ARR:*:DEP:EDDF18
COLOR:RRS_MARKER
{#- South Up #}
FILTER_ASR:EDDF_GND
{{ data.eddf_info['RRSMarker']['18_2400'] | render_symbol('RRS-E') }}
{#- North Up -#}
FILTER_ASR:EDDF_S_GND
{{ data.eddf_info['RRSMarker']['18_2400'] | render_symbol('RRS-W') }}

