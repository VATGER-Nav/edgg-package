// ----------------------------- Stands -----------------------------
{#- TODO: Change simplify() to feat_simplify() when AIXM2 parser gets fixed #}
{#- In comparison to other airports, Frankfurt's AIXM is a special case.
    The GuidanceLine feature set cannot be parsed by Mapbuilder as it is
    geometryless. GuidanceLineMarking is an unstructured set of geometries.
    As Frankfurt changes its markings seemingly with every AIRAC update, 
    it has been decided that it is better to maintain its own set of
    geometries, which must be manually compared every other time.
#}
{%- set tolerance = 0.000005 %}

MAP:Lead-in Lines
AIRPORT:EDDF
FOLDER:Airport Layout
ACTIVE:1
COLOR:LAYOUT_TAXILINE_GREY

// Solid Leadin Lines
{% for uuid, feat in data.eddf_guidanceline['GuidanceLineMarking'].items() if feat.properties['type'] == 'LI_TLANE' %}
{{- feat | simplify(tolerance) | render_line(uuid) }}
{% endfor %}
{% for _, feat in data.eddf_layout['Marking_Line'].items() if feat.properties['style'] == 'SOLID' %}
{{- feat | render_line }}
{% endfor %}

// Dash Leadin Lines
STYLE:TLANE_DASH
{% for _, feat in data.eddf_layout['Marking_Line'].items() if feat.properties['style'] == 'DASH' and feat.properties['is_polyline'] == false %}
{{- feat | render_line }}
{% endfor %}
{% for _, feat in data.eddf_layout['Marking_Line'].items() if feat.properties['style'] == 'DASH' and feat.properties['is_polyline'] == true %}
{{- feat | render_area('OTHER:POLYLINE') }}
{% endfor %}
STYLE:TLANE_DOT
{% for _, feat in data.eddf_layout['Marking_Line'].items() if feat.properties['style'] == 'DOT' %}
{{- feat | render_area('OTHER:POLYLINE') }}
{% endfor %}

// Taxi-Out Arrows
STYLE:SOLID
{% for _, feat in data.eddf_layout['Marking_Poly'].items() if feat.properties['type'] == 'LO_TLANE' %}
{{- feat | render_area('OTHER:REGION') }}
{% endfor %}