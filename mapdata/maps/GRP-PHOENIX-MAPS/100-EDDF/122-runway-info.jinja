// =======================< TORA Distances >=========================

{% for runway in ['25L', '07R', '25C', '07C', '18'] %}
MAP:TORA {{runway}}
AIRPORT:EDDF
FOLDER:Runway Info
LAYER:6
COLOR:TORA_LABEL
ZOOM:300
{#- South Up #}
FILTER_ASR:EDDF_GND
{% for feat in data.eddf_info['TORALabel'] | feat_where('runway', runway) %}
{{- feat | render_text(prop='tora', align=feat.properties.textalign) -}}
{% endfor %}
{#- North Up -#}
FILTER_ASR:EDDF_S_GND
{% for feat in data.eddf_info['TORALabel'] | feat_where('runway', runway) %}
{{- feat | render_text(prop='tora', align=feat.properties.textalign_s) -}}
{% endfor %}
{% endfor %}

// ======================< Runway Designators >======================

MAP:Runway Designators
AIRPORT:EDDF
FOLDER:Runway Info
LAYER:6
ACTIVE:1
COLOR:RUNWAY_LABEL
{{ data.eddf_info['RunwayLabel'] | render_grp }}

// =======================< Runway Markings >========================

MAP:Runway Markings
AIRPORT:EDDF
FOLDER:Runway Info
COLOR:LAYOUT_RUNWAY_MARKING
{{ data.eddf_aixm['RunwayMarking'] | feat_where('colour', 'WHITE') | render_area('OTHER:REGION') }}

COLOR:LAYOUT_TAXIWAY
{{ data.eddf_aixm['RunwayMarking'] | feat_where('colour', 'YELLOW') | render_area('OTHER:REGION') }}