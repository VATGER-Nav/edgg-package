// ---------------------------- Taxilanes --------------------------
{#- TODO: Change simplify() to geom_simplify() when AIXM2 parser gets fixed #}
{#- In comparison to other airports, Frankfurt's AIXM is a special case.
    The GuidanceLine feature set cannot be parsed by Mapbuilder as it is
    geometryless. GuidanceLineMarking is an unstructured set of geometries.
    As Frankfurt changes its markings seemingly with every AIRAC update, 
    it has been decided that it is better to maintain its own set of
    geometries, which must be manually compared every other time.
#}
{%- set tolerance = 0.000005 %}

MAP:Taxilanes
AIRPORT:EDDF
FOLDER:Airport Layout
ACTIVE:1
// Taxilanes not available in Flightsim
COLOR:LAYOUT_RUNWAY
{% for uuid, feat in data.eddf_guidanceline['GuidanceLineMarking'].items() if feat.properties['type'] == 'CLOSED' %}
{{- feat | simplify(tolerance) | render_line(uuid) }}
{% endfor %}

// Yellow Lines
COLOR:LAYOUT_TAXILINE_YELLOW
{% for uuid, feat in data.eddf_guidanceline['GuidanceLineMarking'].items() if feat.properties['type'] == 'TWY' and feat.properties['color'] == 'YELLOW' %}
{{- feat | simplify(tolerance) | render_line(uuid) }}
{% endfor %}

// Orange Lines
COLOR:LAYOUT_TAXILINE_ORANGE
{% for uuid, feat in data.eddf_guidanceline['GuidanceLineMarking'].items() if feat.properties['type'] == 'TWY' and feat.properties['color'] == 'ORANGE' %}
{{- feat | simplify(tolerance) | render_line(uuid) }}
{% endfor %}

// Blue Lines
COLOR:LAYOUT_TAXILINE_BLUE
{% for uuid, feat in data.eddf_guidanceline['GuidanceLineMarking'].items() if feat.properties['type'] == 'TWY' and feat.properties['color'] == 'BLUE' %}
{{- feat | simplify(tolerance) | render_line(uuid) }}
{% endfor %}