AIRPORT:EDDF
FOLDER:Airport Layout
ACTIVE:1

// - - - - - - - Taxilanes not available in Flightsim - - - - - - - -

COLOR:LAYOUT_RUNWAY
{% for feat in GLM_resolved | feat_where('id', *GLM_closed) %}
{%- set taxiway = data.eddf_aixm.resolve(feat.links.connectedTaxiway) %}
{%- set twy_desig = taxiway.properties.designator if taxiway != none else '' %}
{{ feat | feat_simplify(tolerance) | render_line(feat.id +' / '+ twy_desig) }}
{% endfor %}

// - - - - - - - - - - - - - Yellow Lanes - - - - - - - - - - - - - -

COLOR:LAYOUT_TAXILINE_YELLOW
{% for feat in GLM_resolved
    | feat_exclude('id', *(GLM_nodraw + GLM_closed))
    | feat_where('type', 'TWY', 'RWY', 'GATE_TLANE')
    | feat_exclude('colour', 'BLUE', 'ORANGE')
%}
{%- set taxiway = data.eddf_aixm.resolve(feat.links.connectedTaxiway) %}
{%- set twy_desig = taxiway.properties.designator if taxiway != none else '' %}
{{ feat | feat_simplify(tolerance) | render_line(feat.id +' / '+ twy_desig) }}
{% endfor %}
{{ GLM_resolved | feat_where('id', GLM_draw) | feat_simplify(tolerance) | render_line('N8') }}

