// ------------------------------------------------------------------
//                          Approach Window
// ------------------------------------------------------------------

// ----------------------------- Fixes ------------------------------
{#- 
    WARNING: When performing any changes on this file,
    please bring them to the following files as well:
    
     * TOPSKY-EDGG-MAPS\721-vrp.jinja
     * TOPSKY-PHOENIX-MAPS\010-fixes\010-vrp.jinja
#}
{%- set vrp_table = data.topsky_gpkg['VisualReportingPoint'] %}

MAP:VRPs:A
FOLDER:Fixes
COLOR:APPWINDOW_STANDARD
ACTIVE:1
{%- for vrp in vrp_table | feat_where('type', 'CIV') %}
{%- set textalign = vrp.properties['textalign'] %}
SYMBOL:{{ vrp.properties['symbol'] }}:{{ vrp.properties['designator'] }}
{%- endfor %}


MAP:VRPs w/ L:A
FOLDER:Fixes
COLOR:APPWINDOW_STANDARD
{%- for vrp in vrp_table | feat_where('type', 'CIV') %}
{%- set textalign = vrp.properties['textalign'] %}
SYMBOL/{{ textalign }}:
    {{- vrp.properties['symbol'] }}:
    {{- vrp.properties['designator'] }}:
    {{- vrp.properties['text'] }}:
    {{- '-5:0' if textalign == 'RB' else '5:0' }}
{%- endfor %}


MAP:MIL VRPs:A
FOLDER:Fixes
COLOR:APPWINDOW_STANDARD
ACTIVE:1
{%- for vrp in vrp_table | feat_where('type', 'MIL') %}
{%- set textalign = vrp.properties['textalign'] %}
SYMBOL:{{ vrp.properties['symbol'] }}:{{ vrp.properties['designator'] }}
{%- endfor %}


MAP:MIL VRPs w/ L:A
FOLDER:Fixes
COLOR:APPWINDOW_STANDARD
{%- for vrp in vrp_table | feat_where('type', 'MIL') %}
{%- set textalign = vrp.properties['textalign'] %}
SYMBOL/{{ textalign }}:
    {{- vrp.properties['symbol'] }}:
    {{- vrp.properties['designator'] }}:
    {{- vrp.properties['text'] }}:
    {{- '-5:0' if textalign == 'RB' else '5:0' }}
{%- endfor %}