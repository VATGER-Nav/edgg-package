// ------------------------ Restriction Maps ------------------------

MAP:Restrictions
AIRPORT:EDLW
FOLDER:Restrictions
LAYER:2
ZOOM:600

// B
COLOR:RESTRICTIONS_AB
STYLE:SOLID:4
{{ data.edlw_kml['layout']['restrictions']['line']['B'] | render_line }}
TEXTALIGN:RC
{{ data.edlw_kml['layout']['restrictions']['labels']['B'] | to_text('Max MTOW 30t') }}

// K
COLOR:RESTRICTIONS_AB
STYLE:SOLID:4
{{ data.edlw_kml['layout']['restrictions']['line']['K'] | render_line }}

// L
COLOR:RESTRICTIONS_C
STYLE:SOLID:4
{{ data.edlw_kml['layout']['restrictions']['line']['L'] | render_line }}
STYLE:SOLID:1
{{ data.edlw_kml['layout']['restrictions']['poly']['L'] | render_area('OTHER:REGION:/') }}

// Restriction Stands
TEXTALIGN:CC
FONTSIZE:=:9
COLOR:RESTRICTIONS_AB
{% for desig in
[
    'B2',
    'B3',
    'B4',
    'B5',
    'B6',
] %}
{{- data.edlw_kml['layout']['restrictions']['stands'][desig] | to_symbol('STAND') }}
{% endfor %}
COLOR:RESTRICTIONS_C
{% for desig in
[
    '0',
    '1',
    '2',
    '3',
    '5',
    '6',
    '7',
    '8',
    '9',
    '10',
    '11',
    '12',
] %}
{{- data.edlw_kml['layout']['restrictions']['stands'][desig] | to_symbol('STAND') }}
{% endfor %}
COLOR:RESTRICTIONS_D
{% for desig in ['4'] %}
{{- data.edlw_kml['layout']['restrictions']['stands'][desig] | to_symbol('STAND') }}
{% endfor %}

// Reference
COLOR:LAYOUT_LABEL_STAND
FONTSIZE:=:12
{{ data.edlw_kml['layout']['restrictions']['labels']['reference'] | to_text('Reference  ') }}
{{ data.edlw_kml['layout']['restrictions']['labels']['reference'] | to_text('MTOW 30t - up to DH8D   :0:15') }}
{{ data.edlw_kml['layout']['restrictions']['labels']['reference'] | to_text('Code B < 24m (CRJ2/C700):0:30') }}
{{ data.edlw_kml['layout']['restrictions']['labels']['reference'] | to_text('Code C < 36m (A321/B739):0:45') }}
{{ data.edlw_kml['layout']['restrictions']['labels']['reference'] | to_text('Code D < 52m (A310/B763):0:60') }}
FONTSIZE:=:70
COLOR:RESTRICTIONS_AB
{{ data.edlw_kml['layout']['restrictions']['labels']['reference'] | to_text('.:-95:-24') }}
COLOR:RESTRICTIONS_C
{{ data.edlw_kml['layout']['restrictions']['labels']['reference'] | to_text('.:-95:-9') }}
COLOR:RESTRICTIONS_D
{{ data.edlw_kml['layout']['restrictions']['labels']['reference'] | to_text('.:-95:6') }}