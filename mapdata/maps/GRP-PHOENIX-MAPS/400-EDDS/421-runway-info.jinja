// =========================< RRS Markers >==========================

{% for runway in ['25', '07'] %}
MAP:RRS {{runway}}
AIRPORT:EDDS
FOLDER:Runway Info
LAYER:6
ACTIVE:RWY:ARR:EDDS{{runway}}:DEP:*
ACTIVE:RWY:ARR:*:DEP:EDDS{{runway}}
COLOR:RUNWAY_LABEL
{{ data.edds_info['RRSMarker'] | feat_where('runway', runway) | render_symbol('RRS-S') -}}
FONTSIZE:=:12
ZOOM:400
TEXTALIGN:CT
{{ data.edds_info['RRSMarker'] | feat_where('runway', runway) | feat_exclude('text', '1500') | render_text(prop='text', offset=(0,12)) -}}
{{ data.edds_info['RRSMarker'][runway + '_1500'] | render_text(prop='text2', offset=(0,12)) -}}
{{ data.edds_info['RRSMarker'][runway + '_1500'] | render_text(prop='text', offset=(0,24)) }}
{% endfor %}

// =======================< TORA Distances >=========================

{% for runway in ['25', '07'] %}
MAP:TORA {{runway}}
AIRPORT:EDDS
FOLDER:Runway Info
LAYER:6
COLOR:TORA_LABEL
ZOOM:400
{% for feat in data.edds_info['TORALabel'] | feat_where('runway', runway) %}
{{- feat | render_text(prop='tora', align=feat.properties.textalign) -}}
{% endfor %}
{% endfor %}

