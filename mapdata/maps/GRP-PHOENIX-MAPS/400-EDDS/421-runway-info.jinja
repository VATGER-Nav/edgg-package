MAP:Runway Thresholds
AIRPORT:EDDS
FOLDER:Runway Info
LAYER:6
ACTIVE:1
COLOR:RUNWAY_LABEL
{{ data.edds_layout['Marking_Poly'] | feat_where('type', 'THR') | render_area('OTHER:REGION') }}

