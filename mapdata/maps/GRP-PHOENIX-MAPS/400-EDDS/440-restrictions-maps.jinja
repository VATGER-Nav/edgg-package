// =======================< Restriction Maps >=======================

{%- from "_macros.jinja" import render_restriction %}

MAP:Restrictions
AIRPORT:EDDS
FOLDER:Restrictions
ZOOM:400
LAYER:2

// - - - - - - - - - - - Taxiway Restrictions - - - - - - - - - - - -

// Turn S - I
COLOR:RESTRICTIONS_C
STYLE:SOLID:4
{{ data.edds_info['Restriction_Line']['S_I'] | render_line }}

// M (Between H and Exit 3)
COLOR:RESTRICTIONS_C
STYLE:SOLID:4
{{ data.edds_info['Restriction_Line']['M'] | render_line }}

// W/Z
COLOR:RESTRICTIONS_D
STYLE:SOLID:4
{{ data.edds_info['Restriction_Line']['W_Z'] | render_line }}
TEXTALIGN:LC
{{ data.edds_info['RestrictionLabel']['W_Z'] | render_text('Max wingspan 42m') }}
{{ data.edds_info['RestrictionLabel']['W_Z'] | render_text('e.g. B753', offset=(0,12)) }}

// C
COLOR:RESTRICTIONS_D
STYLE:SOLID:4
{{ data.edds_info['Restriction_Line']['C'] | render_line }}

// E
COLOR:RESTRICTIONS_D
STYLE:SOLID:4
{{ data.edds_info['Restriction_Line']['E'] | render_line }}

// G
COLOR:RESTRICTIONS_D
STYLE:SOLID:4
{{ data.edds_info['Restriction_Line']['G'] | render_line }}

// Turn L2 - O
COLOR:RESTRICTIONS_D
STYLE:SOLID:4
{{ data.edds_info['Restriction_Line']['L2_O'] | render_line }}

// Z
COLOR:RESTRICTIONS_D
STYLE:SOLID:4
{{ data.edds_info['Restriction_Line']['Z'] | render_line }}

// D
COLOR:RESTRICTIONS_E
STYLE:SOLID:4
{{ data.edds_info['Restriction_Line']['D'] | render_line }}

// N
COLOR:RESTRICTIONS_F
STYLE:SOLID:4
{{ data.edds_info['Restriction_Line']['N'] | render_line }}
TEXTALIGN:CC
{{ data.edds_info['RestrictionLabel']['N'] | render_text('Max B748') }}

// M/H/O/L2/L3
COLOR:RESTRICTIONS_E
STYLE:SOLID:4
{{ data.edds_info['Restriction_Line']['M_L3_O_H'] | render_line }}
{{ data.edds_info['Restriction_Line']['L2'] | render_line }}

// GAT 29m
COLOR:RESTRICTIONS_AB
STYLE:SOLID:1
{{ data.edds_info['Restriction_Poly']['GAT1'] | render_area('OTHER:REGION:/') }}
TEXTALIGN:LC
{{ data.edds_info['RestrictionLabel']['GAT1'] | render_text('Max wingspan 29m') }}

// GAT 20m
COLOR:RESTRICTIONS_AB
STYLE:SOLID:1
{{ data.edds_info['Restriction_Poly']['GAT2'] | render_area('OTHER:REGION:\\') }}
TEXTALIGN:LC
{{ data.edds_info['RestrictionLabel']['GAT2'] | render_text('Max wingspan 20m') }}

// - - - - - - - - - - - - Stand Restrictions - - - - - - - - - - - -

TEXTALIGN:CC
FONTSIZE:=:9
COLOR:RESTRICTIONS_AB
{% for feat in data.edds_info['RestrictionStand'] | feat_where('restriction', 'B') %}
{{- render_restriction(feat) -}}
{% endfor %}
COLOR:RESTRICTIONS_C
{% for feat in data.edds_info['RestrictionStand'] | feat_where('restriction', 'C') %}
{{- render_restriction(feat) -}}
{% endfor %}
COLOR:RESTRICTIONS_D
{% for feat in data.edds_info['RestrictionStand'] | feat_where('restriction', 'D') %}
{{- render_restriction(feat) -}}
{% endfor %}
COLOR:RESTRICTIONS_E
{% for feat in data.edds_info['RestrictionStand'] | feat_where('restriction', 'E') %}
{{- render_restriction(feat) -}}
{% endfor %}
COLOR:RESTRICTIONS_F
{% for feat in data.edds_info['RestrictionStand'] | feat_where('restriction', 'F') %}
{{- render_restriction(feat) -}}
{% endfor %}

// - - - - - - - - - - - - - - - Reference - - - - - - - - - - - - - 

COLOR:LAYOUT_LABEL_STAND
FONTSIZE:=:12
TEXTALIGN:CC
{{ data.edds_info['RestrictionLabel']['reference'] | render_text('Reference  ', offset=(0,0-15*3)) -}}
{{ data.edds_info['RestrictionLabel']['reference'] | render_text('Code B < 24m (CRJ2/C700)', offset=(0,0-15*2)) -}}
{{ data.edds_info['RestrictionLabel']['reference'] | render_text('Code C < 36m (A321/B739)', offset=(0,0-15*1)) -}}
{{ data.edds_info['RestrictionLabel']['reference'] | render_text('Code D < 52m (A310/B763)', offset=(0,0+15*0)) -}}
{{ data.edds_info['RestrictionLabel']['reference'] | render_text('Code E < 65m (A343/B77W)', offset=(0,0+15*1)) -}}
{{ data.edds_info['RestrictionLabel']['reference'] | render_text('Code F < 80m (A124/B748)', offset=(0,0+15*2)) }}

FONTSIZE:=:70
COLOR:RESTRICTIONS_AB
{{ data.edds_info['RestrictionLabel']['reference'] | render_text('.', offset= (-95,-54-15*2)) -}}
COLOR:RESTRICTIONS_C
{{ data.edds_info['RestrictionLabel']['reference'] | render_text('.', offset= (-95,-54-15*1)) -}}
COLOR:RESTRICTIONS_D
{{ data.edds_info['RestrictionLabel']['reference'] | render_text('.', offset= (-95,-54+15*0)) -}}
COLOR:RESTRICTIONS_E
{{ data.edds_info['RestrictionLabel']['reference'] | render_text('.', offset= (-95,-54+15*1)) -}}
COLOR:RESTRICTIONS_F
{{ data.edds_info['RestrictionLabel']['reference'] | render_text('.', offset= (-95,-54+15*2)) }}