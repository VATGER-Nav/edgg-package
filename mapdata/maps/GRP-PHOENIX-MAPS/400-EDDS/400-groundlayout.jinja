{%- set tolerance = 0.000005 %}

// ======================< Apron Movement Area >=====================

MAP:Apron Area
AIRPORT:EDDS
FOLDER:Airport Layout
ACTIVE:1
COLOR:LAYOUT_APRON
{{ data.edds_layout['ApronElement'] | render_grp }}

// =============================< Roads >============================

MAP:Roads
AIRPORT:EDDS
FOLDER:Airport Layout
COLOR:LAYOUT_TAXIWAY
{{ data.edds_layout['Road'] | render_polyline }}

// =====================< Taxiway Movement Area >====================

MAP:Taxiway Movement Area
AIRPORT:EDDS
FOLDER:Airport Layout
ACTIVE:1
COLOR:LAYOUT_TAXIWAY
{{ data.edds_layout['TaxiwayElement'] | render_grp }}

// ===========================< Taxilanes >==========================

MAP:Taxilanes
AIRPORT:EDDS
FOLDER:Airport Layout
ACTIVE:1
COLOR:LAYOUT_TAXILINE_YELLOW

{% for feat in data.edds_aixm['GuidanceLine']
    | feat_where('type', 'APRON', 'TWY')
    | feat_exclude('designator', '300-303')
%}
{{ feat | feat_simplify(tolerance) | render_line(feat.properties.designator) }}
{% endfor %}

// - - - - - - - - - - - - Custom Markings - - - - - - - - - - - - -

// P1 and P2
{{ data.edds_layout['Marking_Line'] | feat_where('type', 'TWY') | feat_where('style', 'SOLID') | render_line }}

// Link N/S
STYLE:ALTERNATE
{{ data.edds_layout['Marking_Line'] | feat_where('type', 'TWY') | feat_where('style', 'ALTERNATE') | render_polyline }}

// - - - - - - - - - - - - - Orange Lanes - - - - - - - - - - - - - -

COLOR:LAYOUT_TAXILINE_ORANGE
STYLE:SOLID

// 30150913-33b8-49be-80d3-5a4df618ac80
{{ data.edds_aixm.find('30150913-33b8-49be-80d3-5a4df618ac80') | feat_simplify(tolerance) | render_line }}

// - - - - - - - - - - - - - Deicing Lanes - - - - - - - - - - - - - 

COLOR:LAYOUT_TAXILINE_YELLOW
STYLE:ALTERNATE
{{ data.edds_layout['Marking_Line'] | feat_where('type', 'DEICE') | render_line }}

// ===========================< Runways >============================

MAP:Runways
AIRPORT:EDDS
FOLDER:Airport Layout
ACTIVE:1
COLOR:LAYOUT_RUNWAY
{{ data.edds_aixm['RunwayElement'] | feat_exclude('type', 'SHOULDER') | feat_union | feat_simplify(0.00001) | render_grp }}

