{%- from "_macros.jinja" import render_multilinetext -%}

// ========================< Taxiway Labels >========================

// - - - - - - - - - - - - - Label Buffer - - - - - - - - - - - - - -

MAP:Buffer EDDS
AIRPORT:EDDS
FOLDER:Labels
HIDDEN
LAYER:3
ZOOM:400
COLOR:LAYOUT_TAXIWAY
{{ data.edds_info['LabelBuffer']['taxiway'] | render_grp }}

// - - - - - - - - - - - - - - Labels - - - - - - - - - - - - - - - -

MAP:Taxiways
AIRPORT:EDDS
FOLDER:Labels
OTHER_MAP_ACT:=:Labels\Buffer EDDS
LAYER:6
ZOOM:400
FONTSIZE:=:10
COLOR:LAYOUT_LABEL_YELLOW
{{ data.edds_info['TaxiwayLabel']
    | feat_where('zoomlevel', 400)
    | feat_exclude('designator', 'Exit_3')
    | render_text(prop='text')
-}}
{{ data.edds_info['TaxiwayLabel']['Exit_3'] | render_text(prop='text', align='LC') }}

// =========================< Stand Labels >=========================

MAP:Stands
AIRPORT:EDDS
FOLDER:Labels
OTHER_MAP_ACT:=:Labels\Areas  
LAYER:6
ACTIVE:1
ZOOM:600
FONTSIZE:=:9
COLOR:LAYOUT_LABEL_YELLOW
{{ data.edds_info['StandLabel'] | feat_where('zoomlevel', 600) | render_text(prop='designator') }}

ZOOM:1200
COLOR:LAYOUT_LABEL_YELLOW
{{ data.edds_info['StandLabel'] | feat_where('zoomlevel', 1200) | render_text(prop='designator') }}

// =========================< Area Labels >==========================

// There is 2 space symbols at the end of the map name to avoid accidental activation by EDDL and EDDK stand maps
MAP:Areas  
AIRPORT:EDDS
FOLDER:Labels
ACTIVE:1
ZOOM:400
FONTSIZE:=:10
COLOR:LAYOUT_LABEL_STAND
{{ data.edds_info['AreaLabel'] | render_text(prop='text') }}

// =======================< Building Labels >========================

MAP:Buildings
AIRPORT:EDDS
FOLDER:Labels
ZOOM:400
FONTSIZE:=:9
COLOR:LAYOUT_LABEL_STAND
{% for feat in data.edds_info['BuildingLabel'].values() %}
{{ render_multilinetext(feat, 12) }}
{% endfor %}