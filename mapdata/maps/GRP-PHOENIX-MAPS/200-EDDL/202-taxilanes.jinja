// ===========================< Taxilanes >==========================

{%- set tolerance = 0.000005 %}
{%- set nodraw_taxilanes = [
    'AE_LSH1',
	'TWYK1_W_1',
	'TWYL1_23L_1',
	'TWYL1_23L_2',
	'TWYL2_2',
] %}

MAP:Taxilanes
AIRPORT:EDDL
FOLDER:Airport Layout
ACTIVE:1
COLOR:LAYOUT_TAXILINE_YELLOW

{% for feat in data.eddl_aixm['GuidanceLine']
    | feat_where('type', 'TWY', 'GATE_TLANE')
    | feat_exclude('designator', *nodraw_taxilanes)
    if not feat.properties.designator.startswith('DEICI')
%}
{{ feat | feat_simplify(tolerance) | render_line(feat.properties.designator) }}
{% endfor %}

// - - - - - - - - - - - - Custom Markings - - - - - - - - - - - - -

{{ data.eddl_layout['Marking_Line'] | feat_where('type', 'TWY', 'RWY') | feat_where('style', 'SOLID') | render_line }}

STYLE:TLANE_DASH
{{ data.eddl_layout['Marking_Line'] | feat_where('type', 'TWY', 'RWY') | feat_where('style', 'DASHED') | render_polyline }}