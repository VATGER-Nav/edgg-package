// =======================< A380 Taxiroutes >========================

{%- set A380_stands = ['C02A', 'V08B', 'V10A', 'V38B'] %}

// - - - - - - - - - - - - - 23 Direction - - - - - - - - - - - - - -

MAP:23L
AIRPORT:EDDL
FOLDER:A380
LAYER:2
COLOR:RESTRICTIONS_C
{{ data.eddl_info['RestrictionA380_Poly']['23_arr'] | render_area('OTHER:REGION') -}}
COLOR:RESTRICTIONS_D
{{ data.eddl_info['RestrictionA380_Poly']['23_dep'] | render_area('OTHER:REGION') -}}
STYLE:SOLID:3
COLOR:RESTRICTIONS_C
{{ data.eddl_info['RestrictionA380_Line']['23_arr'] | render_line -}}
COLOR:RESTRICTIONS_D
{{ data.eddl_info['RestrictionA380_Line']['23_dep'] | render_line }}

STYLE:SOLID:2
COLOR:RESTRICTIONS_AB
{{ data.eddl_info['RestrictionA380_Line']['taxi_barrier'] | render_line -}}
COLOR:RESTRICTIONS_AB
{{ data.eddl_info['RestrictionA380Label']['taxi_barrier'] | render_symbol('VERBOT_1') -}}
{{ data.eddl_info['RestrictionA380Label']['L6_taxi_barrier'] | render_symbol('VERBOT_1') -}}
COLOR:WHITE
{{ data.eddl_info['RestrictionA380Label']['taxi_barrier'] | render_symbol('VERBOT_2') -}}
{{ data.eddl_info['RestrictionA380Label']['L6_taxi_barrier'] | render_symbol('VERBOT_2') }}

COLOR:RESTRICTIONS_C
TEXTALIGN:RC
{{ data.eddl_info['RestrictionA380Label']['L7'] | render_text('Then via', offset=(0,-12)) -}}
{{ data.eddl_info['RestrictionA380Label']['L7'] | render_text('M, L8, R') }}

COLOR:LAYOUT_LABEL_STAND
FONTSIZE:=:12
TEXTALIGN:CC
{{ data.eddl_info['RestrictionLabel']['reference_1'] | render_text('A380 Taxiroutes', offset=(0,0-15*1)) -}}
{{ data.eddl_info['RestrictionLabel']['reference_1'] | render_text('      - DEP 23L', offset=(0,0+15*0)) -}}
{{ data.eddl_info['RestrictionLabel']['reference_1'] | render_text('      - ARR 23L', offset=(0,0+15*1)) -}}
COLOR:RESTRICTIONS_D
{{ data.eddl_info['RestrictionLabel']['reference_1'] | render_text('_____          ', offset=(0,-6+15*0)) -}}
COLOR:RESTRICTIONS_C
{{ data.eddl_info['RestrictionLabel']['reference_1'] | render_text('_____          ', offset=(0,-6+15*1)) }}

// A380 Stands
ZOOM:600
FONTSIZE:=:9
COLOR:LAYOUT_LABEL_YELLOW
{% for desig in A380_stands %}
{{- data.eddl_info['StandLabel'][desig] | render_text(prop='designator', offset=(0,1)) -}}
{{ data.eddl_info['StandLabel'][desig] | render_text('____', offset=(0,1)) -}}
{% endfor %}
COLOR:RESTRICTIONS_F
{% for desig in A380_stands %}
{{- data.eddl_info['RestrictionStand'][desig] | render_symbol('STAND') -}}
{% endfor %}

