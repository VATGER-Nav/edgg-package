{%- from "_macros.jinja" import render_multilinetext -%}

// ========================< Taxiway Labels >========================

// - - - - - - - - - - - - - Label Buffer - - - - - - - - - - - - - -

MAP:Buffer EDDL
AIRPORT:EDDL
FOLDER:Labels
HIDDEN
LAYER:3
ZOOM:400
COLOR:LAYOUT_TAXIWAY
{{ data.eddl_info['LabelBuffer']['taxiway'] | render_grp }}

COLOR:LAYOUT_APRON
{{ data.eddl_info['LabelBuffer']['apron'] | render_grp }}

// - - - - - - - - - - - - - - Labels - - - - - - - - - - - - - - - -

MAP:Taxiways
AIRPORT:EDDL
FOLDER:Labels
OTHER_MAP_ACT:=:Labels\Buffer EDDL
LAYER:6
ZOOM:400
FONTSIZE:=:10
COLOR:LAYOUT_LABEL_YELLOW
{{ data.eddl_info['TaxiwayLabel'] | feat_where('zoomlevel', 400) | render_text(prop='text') }}

// =========================< Stand Labels >=========================

MAP:Stands
AIRPORT:EDDL
FOLDER:Labels
ACTIVE:1
OTHER_MAP_ACT:=:Labels\Areas
LAYER:6
ZOOM:600
FONTSIZE:=:9
COLOR:LAYOUT_LABEL_YELLOW
{{ data.eddl_info['StandLabel'] | feat_where('zoomlevel', 600) | render_text(prop='designator') }}

ZOOM:1200
COLOR:LAYOUT_LABEL_YELLOW
{{ data.eddl_info['StandLabel'] | feat_where('zoomlevel', 1200) | render_text(prop='designator') }}

// =========================< Area Labels >==========================

MAP:Areas
AIRPORT:EDDL
FOLDER:Labels
ACTIVE:1
LAYER:6
ZOOM:400
FONTSIZE:=:9
COLOR:LAYOUT_LABEL_STAND
{{ data.eddl_info['AreaLabel'] | render_text(prop='text') }}

// ========================< Stopbar Labels >========================

MAP:Checkpoints
AIRPORT:EDDL
FOLDER:Labels
ACTIVE:1
LAYER:6
ZOOM:800
FONTSIZE:=:10
COLOR:LAYOUT_HOLDINGPOINT
TEXTALIGN:CC
{{ data.eddl_info['HoldingPointLabel']['CP1'] | render_text('Check-', offset=(0,-10)) -}}
{{ data.eddl_info['HoldingPointLabel']['CP1'] | render_text('point 1') -}}
{{ data.eddl_info['HoldingPointLabel']['CP2'] | render_text('Check-', offset=(10,-10)) -}}
{{ data.eddl_info['HoldingPointLabel']['CP2'] | render_text('point 2', offset=(10,0)) }}

// =======================< Building Labels >========================

MAP:Buildings
AIRPORT:EDDL
FOLDER:Labels
ZOOM:400
FONTSIZE:=:9
COLOR:LAYOUT_LABEL_STAND
{% for feat in data.eddl_info['BuildingLabel'].values() %}
{{ render_multilinetext(feat, 12) }}
{% endfor %}