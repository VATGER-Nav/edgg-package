{%- set tolerance = 0.000005 %}
{%- set cp_stopbar = [
    '0861cd97-687b-cb82-e063-86c812ac72e3',
    '0861cd97-687c-cb82-e063-86c812ac72e3',
] %}

// =====================< Holding Points CAT I >=====================

MAP:Holding Points CAT I
AIRPORT:EDDL
FOLDER:Holding Points
LAYER:5
ACTIVE:LVP:EDDL:0
COLOR:LAYOUT_HOLDINGPOINT
{% for feat in data.eddl_layout['HoldingPoint_Poly'] | feat_where('type', 'CAT1') %}
{{ feat | render_area('OTHER:REGION', feat.properties.designator) }}
{% endfor %}
STYLE:SOLID:2
{% for feat in data.eddl_layout['HoldingPoint_Line'] | feat_where('type', 'CAT1') %}
{{ feat | render_line(feat.properties.designator) }}
{% endfor %}

// ====================< Holding Points CAT III >====================

MAP:Holding Points CAT II/III
AIRPORT:EDDL
FOLDER:Holding Points
LAYER:5
ACTIVE:LVP:EDDL:1
COLOR:LAYOUT_HOLDINGPOINT_RED
{% for feat in data.eddl_layout['HoldingPoint_Poly'] | feat_where('type', 'CAT3') %}
{{ feat | render_area('OTHER:REGION', feat.properties.designator) }}
{% endfor %}

// ==========================< Stopbars >============================

MAP:Checkpoints
AIRPORT:EDDL
FOLDER:Holding Points
ACTIVE:1
LAYER:5
COLOR:LAYOUT_HOLDINGPOINT
{{ data.eddl_layout['HoldingPoint_Poly'] | feat_where('type', 'CHECKPOINT') | render_area('OTHER:REGION') }}

MAP:All Stopbars
AIRPORT:EDDL
FOLDER:Holding Points
LAYER:5
COLOR:LAYOUT_HOLDINGPOINT
{% for feat in data.eddl_aixm['TaxiwayMarking']
    | feat_where('markingLocation', 'TWY_INT')
    | feat_exclude('id', *cp_stopbar)
    if feat.geometry.geom_type == 'LineString'
%}
{{ feat | feat_join | feat_simplify(tolerance) | render_line(feat.id) }}
{% endfor %}