// =========================< RRS Markers >==========================

{% for runway in ['23L', '05R', '23R', '05L'] %}
MAP:RRS {{runway}}
AIRPORT:EDDL
FOLDER:Runway Info
LAYER:6
ACTIVE:RWY:ARR:EDDL{{runway}}:DEP:*
ACTIVE:RWY:ARR:*:DEP:EDDL{{runway}}
COLOR:RRS_MARKER
{{ data.eddl_info['RRSMarker'] | feat_where('runway', runway) | render_symbol('RRS') -}}
FONTSIZE:=:12
ZOOM:600
TEXTALIGN:CB
{{ data.eddl_info['RRSMarker'] | feat_where('runway', runway) | render_text(prop='text', offset=(0,-10)) }}
{% endfor %}

// =======================< TORA Distances >=========================

{% for runway in ['23L', '05R', '23R', '05L'] %}
MAP:TORA {{runway}}
AIRPORT:EDDL
FOLDER:Runway Info
LAYER:6
COLOR:TORA_LABEL
ZOOM:600
{% for feat in data.eddl_info['TORALabel'] | feat_where('runway', runway) %}
{{- feat | render_text(prop='tora', align=feat.properties.textalign) -}}
{% endfor %}
{% endfor %}

