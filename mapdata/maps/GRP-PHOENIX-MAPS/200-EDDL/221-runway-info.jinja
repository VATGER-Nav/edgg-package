AIRPORT:EDDL
FOLDER:Runway Info
LAYER:6
ACTIVE:1
COLOR:RUNWAY_LABEL
{{ data.eddl_layout['Marking_Poly'] | feat_where('type', 'THR') | render_area('OTHER:REGION') }}

