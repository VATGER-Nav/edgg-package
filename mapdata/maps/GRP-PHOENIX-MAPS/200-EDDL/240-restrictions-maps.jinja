// =======================< Restriction Maps >=======================

{%- from "_macros.jinja" import render_restriction %}

MAP:Restrictions
AIRPORT:EDDL
FOLDER:Restrictions
ZOOM:600
LAYER:2

// - - - - - - - - - - - Taxiway Restrictions - - - - - - - - - - - -

// Turn L6 - M
COLOR:RESTRICTIONS_C
STYLE:SOLID:4
{{ data.eddl_info['Restriction_Line']['L6'] | render_line }}

// Turn M - L3 - T
COLOR:RESTRICTIONS_C
STYLE:SOLID:4
{{ data.eddl_info['Restriction_Line']['L3'] | render_line }}

// A05
COLOR:RESTRICTIONS_D
STYLE:SOLID:4
{{ data.eddl_info['Restriction_Line']['A05'] | render_line -}}
STYLE:SOLID:1
{{ data.eddl_info['Restriction_Poly']['A05'] | render_area('OTHER:REGION') -}}
TEXTALIGN:LC
{{ data.eddl_info['RestrictionLabel']['A05'] | render_text('Max code D') -}}
{{ data.eddl_info['RestrictionLabel']['A05'] | render_text('P1 >> A05', offset=(0,12)) }}

// L2 (Holding Point)
COLOR:RESTRICTIONS_E
STYLE:SOLID:4
{{ data.eddl_info['Restriction_Line']['L2_1a'] | render_line -}}
{{ data.eddl_info['Restriction_Line']['L2_1b'] | render_line -}}
{{ data.eddl_info['Restriction_Line']['L2_1c'] | render_line -}}
TEXTALIGN:RC
{{ data.eddl_info['RestrictionLabel']['L2_1a'] | render_text('Max A343') -}}
{{ data.eddl_info['RestrictionLabel']['L2_1b'] | render_text('Max A343') }}

// L2 (Exit)
COLOR:RESTRICTIONS_AB
STYLE:SOLID:4
{{ data.eddl_info['Restriction_Line']['L2_2'] | render_line -}}
STYLE:SOLID:1
{{ data.eddl_info['Restriction_Poly']['L2_2'] | render_area('OTHER:REGION') -}}
TEXTALIGN:LC
{{ data.eddl_info['RestrictionLabel']['L2_2'] | render_text('No Exit') }}

// GAT
COLOR:RESTRICTIONS_AB
STYLE:SOLID:4
{{ data.eddl_info['Restriction_Line']['GAT_a'] | render_line -}}
{{ data.eddl_info['Restriction_Line']['GAT_b'] | render_line -}}
STYLE:SOLID:1
{{ data.eddl_info['Restriction_Poly']['GAT_a'] | render_area('OTHER:REGION:\\') -}}
TEXTALIGN:RC
{{ data.eddl_info['RestrictionLabel']['GAT'] | render_text('Max wingspan 29m') }}

// Parallel Restrictions
// M and T
// P1 and L5
// L1 and L2
COLOR:RESTRICTIONS_C
TEXTALIGN:CC
{{ data.eddl_info['RestrictionLabel'] | feat_where('id', 'T_M_a', 'T_M_b') | render_symbol('CIRCLE', text='1') -}}
{{ data.eddl_info['RestrictionLabel']['P1_L5'] | render_symbol('CIRCLE', text='2') -}}
{{ data.eddl_info['RestrictionLabel']['L1'] | render_symbol('CIRCLE', text='3') }}

// - - - - - - - - - - - - Stand Restrictions - - - - - - - - - - - -

TEXTALIGN:CC
FONTSIZE:=:9
COLOR:RESTRICTIONS_C
{% for feat in data.eddl_info['RestrictionStand'] | feat_where('restriction', 'C') %}
{{- render_restriction(feat) -}}
{% endfor %}
COLOR:RESTRICTIONS_D
{% for feat in data.eddl_info['RestrictionStand'] | feat_where('restriction', 'D') %}
{{- render_restriction(feat) -}}
{% endfor %}
COLOR:RESTRICTIONS_E
{% for feat in data.eddl_info['RestrictionStand'] | feat_where('restriction', 'E') %}
{{- render_restriction(feat) -}}
{% endfor %}
COLOR:RESTRICTIONS_F
{% for feat in data.eddl_info['RestrictionStand'] | feat_where('restriction', 'F') %}
{{- render_restriction(feat) -}}
{% endfor %}

// - - - - - - - - - - - - - - - Reference - - - - - - - - - - - - - 

COLOR:LAYOUT_LABEL_STAND
FONTSIZE:=:12
TEXTALIGN:CC
{{ data.eddl_info['RestrictionLabel']['reference_1'] | render_text('Reference  ', offset=(0,0-15*3)) -}}
{{ data.eddl_info['RestrictionLabel']['reference_1'] | render_text('Code B < 24m (CRJ2/C700)', offset=(0,0-15*2)) -}}
{{ data.eddl_info['RestrictionLabel']['reference_1'] | render_text('Code C < 36m (A321/B739)', offset=(0,0-15*1)) -}}
{{ data.eddl_info['RestrictionLabel']['reference_1'] | render_text('Code D < 52m (A310/B763)', offset=(0,0+15*0)) -}}
{{ data.eddl_info['RestrictionLabel']['reference_1'] | render_text('Code E < 65m (A343/B77W)', offset=(0,0+15*1)) -}}
{{ data.eddl_info['RestrictionLabel']['reference_1'] | render_text('Code F < 80m (A388/B748)', offset=(0,0+15*2)) }}

FONTSIZE:=:70
COLOR:RESTRICTIONS_AB
{{ data.eddl_info['RestrictionLabel']['reference_1'] | render_text('.', offset= (-95,-54-15*2)) -}}
COLOR:RESTRICTIONS_C
{{ data.eddl_info['RestrictionLabel']['reference_1'] | render_text('.', offset= (-95,-54-15*1)) -}}
COLOR:RESTRICTIONS_D
{{ data.eddl_info['RestrictionLabel']['reference_1'] | render_text('.', offset= (-95,-54+15*0)) -}}
COLOR:RESTRICTIONS_E
{{ data.eddl_info['RestrictionLabel']['reference_1'] | render_text('.', offset= (-95,-54+15*1)) -}}
COLOR:RESTRICTIONS_F
{{ data.eddl_info['RestrictionLabel']['reference_1'] | render_text('.', offset= (-95,-54+15*2)) }}

COLOR:LAYOUT_LABEL_STAND
FONTSIZE:=:12
{{ data.eddl_info['RestrictionLabel']['reference_2'] | render_text('   Parallel taxiing on M and T/T1', offset=(0,0-15*3)) -}}
{{ data.eddl_info['RestrictionLabel']['reference_2'] | render_text('   only for ACFT up to code E    ', offset=(0,0-15*2)) -}}
{{ data.eddl_info['RestrictionLabel']['reference_2'] | render_text('   Parallel taxiing on P1 and L5 ', offset=(0,0-15*1)) -}}
{{ data.eddl_info['RestrictionLabel']['reference_2'] | render_text('   only for ACFT up to code E    ', offset=(0,0+15*0)) -}}
{{ data.eddl_info['RestrictionLabel']['reference_2'] | render_text('   Overtaking on L1 and L2 only  ', offset=(0,0+15*1)) -}}
{{ data.eddl_info['RestrictionLabel']['reference_2'] | render_text('   for ACFT up to A330/A343      ', offset=(0,0+15*2)) -}}
COLOR:RESTRICTIONS_C
{{ data.eddl_info['RestrictionLabel']['reference_2'] | render_text('1.                               ', offset=(0,0-15*3)) -}}
{{ data.eddl_info['RestrictionLabel']['reference_2'] | render_text('2.                               ', offset=(0,0-15*1)) -}}
{{ data.eddl_info['RestrictionLabel']['reference_2'] | render_text('3.                               ', offset=(0,0+15*1)) }}