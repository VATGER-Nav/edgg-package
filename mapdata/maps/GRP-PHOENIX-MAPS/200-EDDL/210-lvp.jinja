// ======================< ILS Critical Areas >======================

{% for runway in ['23L', '23R', '05R'] %}
MAP:{{runway}}
AIRPORT:EDDL
FOLDER:LVP|Heavy
COLOR:LVP_ORTHOGONAL
{{ data.eddl_info['SensitiveArea'][runway+'_orthogonal_a'] | render_area('OTHER:REGION:\\') -}}
{{ data.eddl_info['SensitiveArea'][runway+'_orthogonal_b'] | render_area('OTHER:REGION:\\') -}}
COLOR:LVP_SENSITIVE
{{ data.eddl_info['SensitiveArea'][runway+'_sensitive'] | render_area('OTHER:REGION:\\') -}}
COLOR:LVP_CRITICAL
STYLE:SOLID:2
{{ data.eddl_info['SensitiveArea'][runway+'_critical_loc'] | render_area('OTHER:REGION:\\') -}}
{{ data.eddl_info['SensitiveArea'][runway+'_critical_gs'] | render_area('OTHER:REGION:\\') -}}
// LOC
STYLE:SOLID:2
COLOR:LVP_MARKING
{{ loc_tick(runways.EDDL[runway], 0, -0.01) }}
{{ loc_tick(runways.EDDL[runway], 0, 0.01) }}
{% endfor %}

