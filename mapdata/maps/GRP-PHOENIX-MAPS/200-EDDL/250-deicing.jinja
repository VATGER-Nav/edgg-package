// =====================< Deicing Areas (East) >=====================

MAP:De-Icing 23L/R
AIRPORT:EDDL
FOLDER:Ice/Snow

// - - - - - - - - - - - - - - - Areas - - - - - - - - - - - - - - - 

COLOR:DEICING:LAYOUT_RUNWAY
STYLE:SOLID:2
{{ data.eddl_info['DeicingArea']['DP1E'] | render_area('OTHER:REGION:X') -}}
{{ data.eddl_info['DeicingArea']['DP2E'] | render_area('OTHER:REGION:X') -}}
{{ data.eddl_info['DeicingArea']['DP3E'] | render_area('OTHER:REGION:X') -}}
{{ data.eddl_info['DeicingArea']['DP4E'] | render_area('OTHER:REGION:X') -}}
{{ data.eddl_info['DeicingArea']['V11B'] | render_area('OTHER:REGION:X') }}

// - - - - - - - - - - - - - - Markings - - - - - - - - - - - - - - -

{%- set tolerance = 0.000005 %}

{#- Get all the designators for deicing taxilanes #}
{%- set taxilanes = ['TLL3_2', 'TLL3_3'] %}

{%- for desig in range(53, 64) %}
    {%- set _ = taxilanes.append('TLT_'+desig|string) %}
{%- endfor %}

{%- for feat in data.eddl_aixm['GuidanceLine']
    if feat.properties.designator.startswith('DEICI_O_') or
    feat.properties.designator.startswith('AE_DEICI_A380_')
%}
    {%- set _ = taxilanes.append(feat.properties.designator) %}
{%- endfor %}

COLOR:LAYOUT_TAXILINE_WHITE
STYLE:SOLID:1
{{ data.eddl_info['DeicingMarking_Poly']['DP1E'] | render_area('OTHER:REGION') -}}
{{ data.eddl_info['DeicingMarking_Poly']['DP2E'] | render_area('OTHER:REGION') -}}
{{ data.eddl_info['DeicingMarking_Poly']['DP3E'] | render_area('OTHER:REGION') -}}
{{ data.eddl_info['DeicingMarking_Poly']['DP4E'] | render_area('OTHER:REGION') -}}
{{ data.eddl_info['DeicingMarking_Poly']['V11B'] | render_area('OTHER:REGION') }}

STYLE:SOLID:2
{{ data.eddl_aixm['GuidanceLine'] 
    | feat_where('designator', *taxilanes)
    | feat_join | feat_simplify(tolerance) | render_line
-}}
{{ data.eddl_info['DeicingMarking_Line']['DP1E'] | render_line }}

