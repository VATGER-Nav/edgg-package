// - - - - - - - - - - - - - - Orange Lanes - - - - - - - - - - - - -

{%- set exclude_orange = ['DEICI_O_M2', 'DEICI_O_O'] %}
{%- set orangelane = [] %}

{#- Get all the designators for orange lines #}
{%- for feat in data.eddl_aixm['GuidanceLine']
    | feat_exclude('designator', *exclude_orange)
    if feat.properties.designator.startswith('DEICI_O_')
%}
    {%- set _ = orangelane.append(feat.properties.designator) %}
{%- endfor %}

COLOR:LAYOUT_TAXILINE_ORANGE
{{ data.eddl_aixm['GuidanceLine'] | feat_where('designator', *orangelane) | feat_join | feat_simplify(tolerance) | render_line }}