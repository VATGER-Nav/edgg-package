{%- set vrp_table = data.topsky_gpkg['VisualReportingPoint'] %}

MAP:VRPs
FOLDER:VFR
COLOR:Active_Map_Type_1
{%- for vrp in vrp_table | feat_where('type', 'CIV') %}
{%- set textalign = vrp.properties['textalign'] %}
SYMBOL/{{ textalign }}:
    {{- vrp.properties['symbol'] }}:
    {{- vrp.properties['designator'] }}:
    {{- vrp.properties['text'] }}:
    {{- '-5:0' if textalign == 'RB' else '5:0' }}
{%- endfor %}

MAP:MIL VRPs
FOLDER:VFR
COLOR:Active_Map_Type_1
{%- for vrp in vrp_table | feat_where('type', 'MIL') %}
{%- set textalign = vrp.properties['textalign'] %}
SYMBOL/{{ textalign }}:
    {{- vrp.properties['symbol'] }}:
    {{- vrp.properties['designator'] }}:
    {{- vrp.properties['text'] }}:
    {{- '-5:0' if textalign == 'RB' else '5:0' }}
{%- endfor %}

MAP:Hospitals
FOLDER:VFR
COLOR:Active_Map_Type_1
{%- for name, geom in data.topsky['common']['vfr']['EDGG_Hospitals'].items() %}
{{ geom | to_symbol('HELIPAD') }}:{{name}}:0:-13
{%- endfor %}