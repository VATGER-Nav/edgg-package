{%- set vrp_table = data.topsky_gpkg['VisualReportingPoint'] %}

MAP:VRPs
FOLDER:VFR
COLOR:Active_Map_Type_1
{%- for _, vrp in vrp_table.items() if vrp.properties['type'] == 'CIV' %}
{%- if vrp.properties["text_align"] == 'RB' %}
SYMBOL/RB:{{vrp.properties['symb']}}:{{vrp.properties['desig']}}:{{vrp.properties['name']}}:-5:0
{%- else %}
SYMBOL/LB:{{vrp.properties['symb']}}:{{vrp.properties['desig']}}:{{vrp.properties['name']}}:5:0
{%- endif%}
{%- endfor %}

MAP:MIL VRPs
FOLDER:VFR
COLOR:Active_Map_Type_1
{%- for _, vrp in vrp_table.items() if vrp.properties['type'] == 'MIL' %}
{%- if vrp.properties["text_align"] == 'RB' %}
SYMBOL/RB:{{vrp.properties['symb']}}:{{vrp.properties['desig']}}:{{vrp.properties['name']}}:-5:0
{%- else %}
SYMBOL/LB:{{vrp.properties['symb']}}:{{vrp.properties['desig']}}:{{vrp.properties['name']}}:5:0
{%- endif%}
{%- endfor %}

MAP:Hospitals
FOLDER:VFR
COLOR:Active_Map_Type_1
{%- for name, geom in data.topsky['common']['vfr']['EDGG_Hospitals'].items() %}
{{ geom | to_symbol('HELIPAD') }}:{{name}}:0:-13
{%- endfor %}